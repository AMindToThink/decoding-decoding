\@writefile{toc}{\contentsline {section}{\numberline {1}Question}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Two complementary experiments}{1}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Closed-loop badness (`belief\_sweep').}{1}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Belief-invariance (`belief\_invariance').}{1}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Closed-loop result: full correction looks best}{1}{section.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Top 5 closed-loop configurations. $H @ \beta ^{\mathrm  {target}}$ and $M @ \beta ^{\mathrm  {target}}$ are late-window mean sample entropy (nats) and max-$P_{\text  {sample}}$.}}{2}{table.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Closed-loop badness in $(\gamma , p)$, one panel per $\alpha $.}}{2}{figure.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Invariance result: no correction wins; $\gamma < 1$ caps the damage}{2}{section.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Top 5 belief-invariance configurations. `var' is the per-prompt variance (nats$^2$) of CE on the natural continuation across $\beta ^{\mathrm  {prefix}} \in \{0.5, 1, 2\}$. Lower is better.}}{2}{table.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(a) $p = 0$ wins trivially.}{2}{section*.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Variance of CE across $\beta ^{\mathrm  {prefix}}$ in $(\gamma , p)$, one panel per $\alpha $. Cell label = raw variance (nats$^2$). $\gamma = 1$ amplifies the prefix-induced filter bias catastrophically as $p$ grows; $\gamma < 1$ keeps variance under 0.07 across the entire $p$ range.}}{3}{figure.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(b) Among $p > 0$, $\gamma < 1$ is essential.}{3}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Why do the two metrics disagree?}{3}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Recommended values}{3}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Limitations}{4}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Bottom line}{4}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces CE on natural-text continuation as a function of $p$, colored by $\beta ^{\mathrm  {prefix}}$. At $\gamma = 1$ (bottom row), the $\beta ^{\mathrm  {pre}}=0.5$ curve (red) grows exponentially with $p$. At $\gamma < 1$, all curves stay within $\approx 0.1$ nat of each other.}}{5}{figure.3}\protected@file@percent }
